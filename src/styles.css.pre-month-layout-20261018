/* Homepage monthly overview: intentionally scoped so the Plans tab keeps its
   existing full-academic-year forecast, comparison and daily drilldown. */
.home-plan-summary { padding: 22px 24px 24px; }
.home-plan-summary h3 { margin: 0 0 20px; font-size: 20px; line-height: 1.35; color: #18312e; }
.home-month-heading { display: flex; align-items: baseline; flex-wrap: wrap; justify-content: space-between; gap: 6px 12px; margin-bottom: 14px; }
.home-month-heading h4 { margin: 0; font-size: 16px; line-height: 1.4; font-weight: 650; }
.home-month-heading > span { font-size: 12px; color: #81908d; }
.home-month-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr); gap: 14px; }
.home-month-planned, .home-month-actual { background: #f2f7f6; border-radius: 12px; min-width: 0; min-height: 112px; }
.home-month-planned { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; padding: 14px 8px; text-align: center; }
.home-month-planned > span, .home-month-actual-total > span { font-size: clamp(13px, 2.6vw, 16px); color: #203b36; }
.home-month-planned strong, .home-month-actual-total strong { font-size: clamp(22px, 4.3vw, 28px); line-height: 1.15; font-weight: 750; color: #19322e; white-space: nowrap; }
.home-month-planned strong small, .home-month-actual-total strong small { font-size: .68em; font-weight: 600; }
.home-month-actual { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.2fr); align-items: center; padding: 14px 12px; }
.home-month-actual-total { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 10px; min-width: 0; text-align: center; }
.home-month-actual-detail { display: flex; flex-direction: column; justify-content: center; gap: 12px; align-self: stretch; min-width: 0; border-left: 1px solid #637771; padding-left: 12px; }
.home-month-actual-detail > span { font-size: clamp(12px, 2.1vw, 14px); line-height: 1.35; color: #203b36; text-align: center; }
.home-month-actual-detail b { display: block; font-size: 16px; font-weight: 750; margin-top: 2px; }
@media (max-width: 480px) {
  .home-plan-summary { padding: 18px 16px 20px; }
  .home-plan-summary h3 { font-size: 19px; margin-bottom: 16px; }
  .home-month-grid { grid-template-columns: 1fr; gap: 10px; }
  .home-month-planned { min-height: 84px; flex-direction: row; justify-content: space-between; padding: 14px 20px; }
  .home-month-actual { min-height: 108px; padding: 12px 14px; }
  .home-month-planned strong, .home-month-actual-total strong { font-size: 25px; }
  .home-month-actual-detail > span { font-size: 13px; }
  .progress-breakdown { gap: 8px; }
  .progress-metric { padding: 14px 6px; }
  .progress-note { line-height: 1.7; }
}


/* Automatic travel-plan categorisation: one stored plan can display several runs. */
.plan-entry-main { flex: 1 1 0; min-width: 0; }
.plan-title-line { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; }
.plan-title-line strong { overflow-wrap: anywhere; }
.plan-segment-line + .plan-segment-line { margin-top: 8px; }
.plan-type-label { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; border-radius: 8px; padding: 6px 10px; line-height: 1.4; font-size: 13px; font-weight: 700; }
.plan-type-self { color: #fff; background: #d97706; }
.plan-type-course { color: #fff; background: #0f766e; }
.plan-list .plan-segment-note { margin: 10px 0 0; color: #617a74; font-size: 12px; }
.plan-auto-preview { padding: 11px 13px; margin: 10px 0 12px; border: 1px solid #dce8e4; background: #f7faf9; border-radius: 12px; }
.plan-auto-preview .page-note { margin: 0 0 9px; }
.plan-auto-preview .plan-segment-line { font-size: 13px; }

/* Date-rule marks inside the travel-plan date picker. */
.range-legend { display:flex; flex-wrap:wrap; align-items:center; gap:6px 13px; margin:8px 0; font-size:11px; color:#60736f; }
.range-legend span { display:inline-flex; align-items:center; gap:6px; }
.range-legend .mark-holiday { display:inline-block; width:11px; height:11px; border-radius:3px; background:#ffe6a0; border:1px solid #dfb446; }
.range-grid button { position:relative; min-width:0; }
.range-grid button.holiday:not(.edge):not(.between) { background:#fff0bc; color:#77520c; }
.range-grid button.between { box-shadow:inset 0 0 0 2px #3a9583; }
.range-grid button.edge { background:#0f766e; color:white; font-weight:800; box-shadow:inset 0 0 0 2px #086052; }
.range-day-tags { position:absolute; top:1px; right:1px; display:flex; flex-direction:column; align-items:flex-end; gap:2px; pointer-events:none; }
/* The same purple "课" mark used in the stay calendar. */
.range-grid .course-mark, .range-legend .course-mark { display:inline-grid; place-items:center; width:18px; height:18px; border-radius:5px; background:#7952a0; color:white; font-size:11px; font-weight:800; line-height:1; font-style:normal; }
.range-legend .course-mark { width:16px; height:16px; font-size:10px; }
.range-day-tag { display:inline-grid; place-items:center; min-width:15px; height:14px; border-radius:3px; background:#ffe6a0; color:#77520c; font-size:9px; font-weight:750; line-height:1; }
.range-grid button.edge .range-day-tag { color:#77520c; }
.range-grid button:disabled { opacity:.65; cursor:wait; }
.range-status { color:#60736f; font-size:12px; margin:6px 0; }
.range-explain { font-size:12px; color:#677a74; line-height:1.6; margin:9px 0 0; }
.plan-date-review { margin:12px 0; padding:14px; border-radius:12px; border:1px solid #ebcdad; background:#fffbf5; color:#63472b; font-size:13px; }
.plan-date-review h4 { margin:0 0 8px; font-size:15px; color:#88500e; }
.plan-date-review > p { margin:6px 0 10px; line-height:1.6; }
.review-group { border-top:1px solid #f0dfc8; padding-top:10px; margin-top:10px; }
.review-group > strong { font-size:13px; }
.review-group p { margin:5px 0; font-size:12px; line-height:1.6; }
.review-group ul { margin:4px 0 6px; padding-left:18px; max-height:156px; overflow-y:auto; overflow-wrap:anywhere; }
.review-group li { margin:3px 0; }
.plan-date-review .range-actions { flex-wrap:wrap; }

