:root {
  font-family: Inter, "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
  color: #17312e;
  background: #f2f6f5;
  font-size: 16px;
}

select { font: inherit; width: 100%; padding: 13px 14px; border: 1px solid #cfddda; border-radius: 12px; background: #fbfdfc; }
.section-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
.plan-list { display: grid; gap: 12px; }
.plan-list .course-card { display: flex; align-items: center; justify-content: space-between; }
.plan-list p { margin: 5px 0 0; color: #71837f; font-size: 13px; }
.switch { display: flex; grid-template-columns: auto 1fr; align-items: center; }
.switch input { width: 20px; }
.link { text-decoration: none; display: inline-block; margin-left: 8px; }
.row-actions { display: flex; gap: 5px; }
.row-actions button { border: 0; background: #edf5f3; color: #0f766e; border-radius: 7px; padding: 6px; }
.calendar-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.calendar-title .secondary { width: 44px; height: 44px; border-radius: 14px; font-size: 24px; }
.calendar-legend { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 22px; margin: 12px 4px 14px; font-size: 13px; font-weight: 550; }
.calendar-legend span { display: inline-flex; align-items: center; gap: 7px; color: #405954; }
.calendar-legend i { display: inline-block; width: 13px; height: 13px; border-radius: 4px; flex: 0 0 auto; }
.legend-effective i { background: #d9eddf; }
.legend-partial i { background: #fff0c6; }
.calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0,1fr)); gap: 5px; background: white; border: 1px solid #dce7e4; border-radius: 22px; padding: 12px; }
.calendar-grid b,.calendar-grid .calendar-day { min-height: 48px; display: grid; place-items: center; position: relative; font-size: 14px; }
.calendar-grid b { color: #70817e; font-weight: 500; }
.calendar-day { border: 1px solid transparent; color: #263d38; border-radius: 12px; font: inherit; font-weight: 600; cursor: pointer; }
.calendar-day.effective { background: #d9eddf; }
.calendar-day.invalid { background: #ffebd4; color: #794b25; }
.calendar-day.outside-year { background: #eef0ef; color: #9ea9a3; }
.calendar-day.selected { border: 2px solid #4c7967; }
.calendar-day .stay-mark { position: absolute; bottom: 5px; left: 50%; transform: translateX(-50%); width: 8px; height: 8px; border-radius: 50%; background: #e3443f; }
.calendar-day .course-mark { position: absolute; right: 0; top: 0; display: grid; place-items: center; width: 18px; height: 18px; border-radius: 5px; background: #7952a0; color: white; font-size: 11px; font-weight: 800; }
.calendar-detail { margin: 10px 2px 18px; padding: 10px 12px; border-radius: 10px; background: #f3f8f6; color: #405954; font-size: 13px; }
.year-picker { display: flex; align-items: center; gap: 8px; margin: 0; color: #60736f; font-size: 13px; }
.year-picker select { width: auto; max-width: 220px; padding: 6px 28px 6px 8px; color: #0f4c46; font-weight: 700; }
.header-actions { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
.pending-reminder { position: relative; display: grid; place-items: center; width: 42px; height: 42px; border: 1px solid #dce7e4; border-radius: 50%; background: white; color: #0f4c46; }
.pending-badge { position: absolute; top: -2px; right: -2px; width: 13px; height: 13px; border: 2px solid white; border-radius: 50%; background: #e65342; }
.account-card { padding: 20px; }
.user-table > div { align-items: center; }
@media (max-width: 760px) {
  .section-bar, .plan-list .course-card { align-items: flex-start; }
  .row-actions { width: 100%; }
  .user-table > div { flex-wrap: wrap; }
}
* {
  box-sizing: border-box;
}
body {
  margin: 0;
  min-height: 100vh;
}
button,
input {
  font: inherit;
}
button {
  cursor: pointer;
}
.loading {
  display: grid;
  place-items: center;
  min-height: 100vh;
}
/* 登录页背景只在未登录界面显示，原图为用户提供的澳门风景 */
.auth-page {
  min-height: 100vh;
  min-height: 100dvh;
  background-image: linear-gradient(90deg, rgba(245, 250, 248, .42), rgba(248, 250, 246, .10) 67%, rgba(249, 249, 245, .16)), url('/login-background.png');
  background-size: cover;
  background-position: center 60%;
  background-repeat: no-repeat;
}
.auth-shell {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1fr 440px;
  max-width: 1080px;
  margin: auto;
  align-items: center;
  gap: 72px;
  padding: 40px;
}
.brand .logo {
  display: block;
  width: 64px;
  height: 64px;
  object-fit: cover;
  border-radius: 18px;
  box-shadow: 0 8px 24px rgba(17, 55, 43, .18);
}
.brand h1 {
  font-size: 48px;
  margin: 24px 0 10px;
  color: #183b35;
  text-shadow: 0 1px 14px rgba(255, 255, 255, .90);
}
.brand p {
  font-size: 19px;
  color: #28443e;
  text-shadow: 0 1px 12px rgba(255, 255, 255, .95);
}
.auth-card,
.progress-card,
.status-card,
.list,
.course-card,
.ranking-list,
.admin-card {
  background: white;
  border: 1px solid #dce7e4;
  border-radius: 24px;
  box-shadow: 0 18px 50px #2749440d;
}
.auth-card {
  padding: 28px;
  background: rgba(255, 255, 255, .94);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 20px 65px rgba(25, 55, 48, .19);
}
/* 登录卡片下方的版本与帮助入口（只在未登录界面展示） */
.auth-panel { width: 100%; min-width: 0; }
.auth-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  margin-top: 18px;
  padding: 12px 16px;
  border-radius: 14px;
  background: rgba(255, 255, 255, .74);
  backdrop-filter: blur(9px);
  -webkit-backdrop-filter: blur(9px);
  font-size: 13px;
  line-height: 1.5;
}
.auth-footer a {
  color: #215d54;
  text-decoration: none;
  font-weight: 550;
  border-radius: 4px;
  text-underline-offset: 3px;
}
.auth-footer a:hover,
.auth-footer a:focus-visible { text-decoration: underline; }
.seg {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: #edf3f1;
  border-radius: 12px;
  padding: 4px;
  margin-bottom: 24px;
}
.seg button {
  border: 0;
  background: transparent;
  padding: 10px;
  border-radius: 9px;
  color: #6b7f7b;
}
.seg .active {
  background: white;
  color: #0f766e;
  font-weight: 700;
}
label {
  display: grid;
  gap: 8px;
  font-size: 14px;
  font-weight: 650;
  margin: 15px 0;
}
input {
  width: 100%;
  padding: 13px 14px;
  border: 1px solid #cfddda;
  border-radius: 12px;
  background: #fbfdfc;
}
.primary,
.check {
  width: 100%;
  border: 0;
  border-radius: 13px;
  padding: 14px 18px;
  background: #0f766e;
  color: white;
  font-weight: 750;
}
.compact {
  width: auto;
  padding: 10px 16px;
}
.error {
  color: #b42318;
  background: #feeceb;
}
.success {
  color: #166534;
  background: #dcfce7;
}
.app-shell {
  max-width: 720px;
  margin: auto;
  min-height: 100vh;
  padding: 28px 20px 100px;
}
.app-shell header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22px;
}
.app-shell h1 {
  margin: 4px 0 0;
  font-size: 27px;
}
.eyebrow,
.page-note {
  font-size: 13px;
  color: #728580;
}
.ghost,
.secondary,
.danger {
  border: 1px solid #d5e1de;
  background: white;
  border-radius: 11px;
  padding: 9px 13px;
  color: #48615c;
}
/* Student homepage: fixed cumulative stay overview with the complete, visible rules. */
.progress-card { padding: clamp(18px, 4vw, 26px); }
.progress-title {
  margin: 0;
  font-size: clamp(17px, 3.2vw, 20px);
  line-height: 1.4;
  font-weight: 750;
  color: #213d37;
}
.progress-total {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
  padding: 14px 0 20px;
  text-align: center;
}
.progress-total strong {
  color: #d97706;
  font-size: clamp(42px, 8.5vw, 54px);
  font-weight: 750;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}
.progress-total strong small { font-size: .44em; font-weight: 650; }
.progress-total > span { color: #688079; font-size: clamp(12px, 2.5vw, 13px); }
.progress-breakdown { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.progress-metric {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-width: 0;
  padding: 16px 10px;
  background: #f2f7f6;
  border-radius: 14px;
  text-align: center;
}
.progress-metric > span { color: #28423c; font-size: clamp(13px, 2.5vw, 15px); line-height: 1.5; font-weight: 650; }
.progress-metric > span small { display: block; color: #738782; font-size: 12px; font-weight: 500; }
.progress-metric strong { color: #d97706; font-size: clamp(27px, 6vw, 34px); line-height: 1.15; font-variant-numeric: tabular-nums; }
.progress-metric strong small { font-size: .58em; font-weight: 650; }
.progress-note { border-top: 1px solid #e3ece9; margin-top: 16px; padding-top: 18px; font-size: clamp(12px, 2.5vw, 13px); line-height: 1.8; color: #546e67; }
.progress-note h3 { margin: 0 0 8px; color: #2a4b42; font-size: 14px; font-weight: 750; }
.progress-note ol { margin: 0; padding-left: 1.65em; }
.progress-note li { padding-left: 1px; margin-bottom: 8px; }
.progress-note li b { color: #304e46; font-weight: 700; }
.progress-note p { margin: 10px 0 0; padding: 10px 12px; background: #f3f7f6; border-radius: 10px; color: #647a73; }
.status-card {
  margin-top: 16px;
  padding: 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}
.status-card p,
.list p,
.ranking-list p {
  margin: 5px 0 0;
  color: #7b8e89;
  font-size: 13px;
}
.dot {
  display: inline-block;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #9aaba7;
  margin-right: 8px;
}
.dot.on {
  background: #16a34a;
}
.status-card .check {
  width: auto;
  min-width: 110px;
}
.actions {
  display: flex;
  gap: 8px;
}
.quick {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 16px;
}
.quick button {
  border: 1px solid #d8e5e2;
  background: white;
  border-radius: 18px;
  padding: 20px 12px;
  color: #31514b;
  font-weight: 700;
}
.quick b {
  display: block;
  font-size: 24px;
  color: #0f766e;
  margin-bottom: 6px;
}
.list,
.ranking-list {
  overflow: hidden;
}
.list article,
.ranking-list article {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 17px 20px;
  border-bottom: 1px solid #e7efed;
}
.danger {
  color: #b42318;
  border-color: #f1c8c5;
}
.course-list {
  display: grid;
  gap: 14px;
}
.course-card {
  padding: 20px;
}
.course-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.course-head h3 {
  margin: 0;
}
.date-check {
  display: flex;
  align-items: center;
  gap: 10px;
}
.date-check input {
  width: 20px;
}
.ranking-list article.me {
  background: #ecfdf8;
}
.ranking-list article > b {
  width: 32px;
  font-size: 20px;
  color: #0f766e;
}
.ranking-list article > div {
  flex: 1;
}
.ranking-list small {
  background: #0f766e;
  color: white;
  border-radius: 8px;
  padding: 2px 6px;
}
.admin-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}
.admin-card {
  padding: 18px;
}
.admin-card.wide {
  grid-column: 1/-1;
}
.two {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.mini-list {
  margin-top: 16px;
}
.mini-list > div,
.user-table > div {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  padding: 10px 0;
  border-top: 1px solid #e6eeec;
  font-size: 13px;
}
.mini-list button {
  border: 0;
  background: transparent;
  color: #b42318;
}
.user-table small {
  display: block;
  color: #71837f;
}
.toast {
  position: fixed;
  left: 50%;
  bottom: 90px;
  transform: translateX(-50%);
  z-index: 20;
  border-radius: 10px;
  padding: 10px 12px;
}
nav {
  position: fixed;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: min(720px, 100%);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
  background: #ffffffee;
  border-top: 1px solid #dce6e4;
}
nav button {
  border: 0;
  background: transparent;
  color: #82928f;
  padding: 8px;
}
nav .active {
  color: #0f766e;
  font-weight: 800;
}
.overlay {
  position: fixed;
  inset: 0;
  background: #102b2766;
  display: grid;
  place-items: end center;
  z-index: 30;
}
.modal {
  width: min(720px, 100%);
  background: white;
  border-radius: 24px 24px 0 0;
  padding: 24px 22px calc(24px + env(safe-area-inset-bottom));
}
.full {
  width: 100%;
  margin-top: 10px;
}
.empty-card {
  text-align: center;
  padding: 30px;
  color: #758783;
}
@media (max-width: 760px) {
  .auth-page {
    background-position: center center;
  }
  .auth-shell {
    display: block;
    padding: 28px 20px calc(28px + env(safe-area-inset-bottom));
  }
  .brand {
    text-align: center;
    margin: 24px 0 28px;
  }
  .brand .logo {
    margin: auto;
  }
  .brand h1 {
    font-size: 36px;
  }
  .brand p {
    font-size: 16px;
  }
  .auth-card {
    padding: 22px;
  }
  .meta {
    gap: 8px;
    flex-wrap: wrap;
  }
  .progress-head strong {
    font-size: 44px;
  }
  .status-card {
    align-items: flex-start;
    flex-direction: column;
  }
  .status-card .check,
  .actions {
    width: 100%;
  }
  .quick {
    grid-template-columns: 1fr 1fr;
  }
  .admin-grid {
    grid-template-columns: 1fr;
  }
  .admin-card.wide {
    grid-column: auto;
  }
  .two {
    grid-template-columns: 1fr;
  }
  .course-head {
    align-items: flex-start;
    gap: 10px;
  }
}

.account-logout { margin-top: 18px; width: 100%; }

.account-admin { width: 100%; margin-top: 18px; }

.announcement-card { background: #e7f4f0; border: 1px solid #cce8de; border-radius: 20px; padding: 16px 18px; margin-bottom: 16px; color: #164b42; }
.announcement-heading { display: flex; align-items: center; gap: 8px; font-size: 15px; }
.announcement-icon { background: #116b61; color: white; padding: 3px 7px; border-radius: 6px; font-size: 11px; font-weight: 700; }
.announcement-card p { margin: 10px 0 0; white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.6; }
.admin-card textarea { display: block; width: 100%; margin-top: 7px; border: 1px solid #cfddda; background: #fbfdfc; border-radius: 12px; padding: 12px; font: inherit; resize: vertical; }
.announcement-editor-actions { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 12px; }
.announcement-editor-actions small { color: #60736f; }

.modal { max-height: min(90vh, 820px); overflow-y: auto; }
.range-trigger { width: 100%; margin-top: 7px; display: flex; align-items: center; justify-content: space-between; border: 1px solid #cfddda; background: #fbfdfc; border-radius: 12px; padding: 13px 14px; color: #17312e; font: inherit; text-align: left; }
.range-picker { margin: 12px 0 16px; padding: 12px; border: 1px solid #d8e5e2; border-radius: 16px; background: #f8fbfa; }
.range-head { display: flex; align-items: center; justify-content: space-between; }
.range-head button { border: 0; background: transparent; color: #0f766e; font-size: 30px; padding: 0 12px; }
.range-hint { min-height: 20px; margin: 10px 0; color: #60736f; font-size: 13px; }
.range-grid { display: grid; grid-template-columns: repeat(7,minmax(0,1fr)); gap: 3px; text-align: center; }
.range-grid b,.range-grid button { min-height: 38px; display: grid; place-items: center; font-size: 13px; }
.range-grid b { color: #71837f; font-weight: 500; }
.range-grid button { border: 0; border-radius: 9px; background: transparent; color: #17312e; }
.range-grid button.between { background: #d6eae3; border-radius: 0; }
.range-grid button.edge { background: #0f766e; color: white; font-weight: 800; }
.range-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px; }
.range-actions button:disabled { opacity: .5; cursor: not-allowed; }
/* R001: day-level verdicts and a bounded year-management panel. */
.calendar-day.partial { background: #fff0c6; color: #775621; }
.calendar-day.pending { background: #e2e8ed; color: #415869; }
.date-rules-card .page-note { margin-bottom: 10px; }
/* Align the year field, sync button and sync summary along the same control row.
   The global label margin (15px 0) otherwise leaves the input 15px higher. */
.date-rules-toolbar, .date-rule-form {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: flex-end;
  margin: 16px 0;
}
.date-rules-toolbar label, .date-rule-form label {
  flex: 1 1 150px;
  min-width: 130px;
  margin: 0;
}
.date-rules-toolbar label { flex: 0 0 164px; }
.date-rules-toolbar label input,
.date-rules-toolbar > button { min-height: 52px; }
.date-rules-toolbar > button { white-space: nowrap; }
.date-rules-toolbar > span {
  display: inline-flex;
  align-items: center;
  min-height: 52px;
}
@media (max-width: 600px) {
  .date-rules-toolbar label { flex: 1 1 100%; }
  .date-rules-toolbar > span { min-height: 44px; }
  .date-rule-form label { flex: 1 1 100%; }
}
.date-exceptions-empty { padding: 12px; }
.date-rule-details { margin-top: 16px; }
.date-rule-details summary { cursor: pointer; font-weight: 600; padding: 12px 2px; }
.date-rule-details .date-rules-list { margin-top: 8px; }
.date-rules-list { max-height: 340px; overflow-y: auto; border: 1px solid #d9e4df; border-radius: 10px; }
.date-rules-row { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 10px; border-bottom: 1px solid #e5ede9; }
.date-rules-row:last-child { border-bottom: 0; }
.date-rules-row p { margin: 4px 0; }
.date-rules-row small { color: #536b61; }
.date-rules-row .row-actions { flex-wrap: wrap; justify-content: end; }
@media(max-width: 600px) { .date-rules-row { align-items: flex-start; flex-direction: column; } }

/* R002: compact and responsive forecast cards; preserve R001 styles. */
.plan-summary { background:#fff; border:1px solid #d9e5e3; border-radius:22px; padding:20px 24px; margin:18px 0; }
.plan-summary h3 { margin:0 0 10px; }
.plan-summary .page-note { margin:8px 0 12px; }
.plan-metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; margin:15px 0 0; }
.plan-metrics > div { display:flex; flex-direction:column; gap:8px; background:#f3f8f7; border-radius:12px; padding:13px 10px; min-width:0; }
.plan-metrics span { color:#57716d; font-size:13px; }
.plan-metrics strong { font-size:24px; overflow-wrap:anywhere; }
.plan-item-forecast { margin:7px 0 0; font-size:13px; color:#166b60; }
@media (max-width:760px) {
  .plan-summary { padding:16px; }
  .plan-metrics { grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; }
  .plan-metrics > div { padding:12px 8px; }
  .plan-metrics strong { font-size:20px; }
}

/* R004: give the teacher overview enough width without changing student pages. */
.app-shell.admin-shell { max-width: 1120px; }
.app-shell.admin-shell .admin-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.app-shell.admin-shell .admin-card { min-width: 0; }
@media (max-width: 760px) {
  .app-shell.admin-shell .admin-grid { grid-template-columns: minmax(0,1fr); }
}

/* R003: self-drive companion seat reservation cards. */
.companion-card { gap: 18px; }
.companion-main { min-width: 0; flex: 1; }
.companion-actions { display: flex; align-items: center; justify-content: flex-end; gap: 8px; flex: 0 0 auto; }
.seat-summary, .seat-owner-summary { color: #315f58 !important; font-weight: 650; }
.seat-full { color: #a63a2d; font-weight: 750; }
.reservation-ok { color: #0f766e !important; font-weight: 800; }
.owner-badge { display: inline-flex; align-items: center; padding: 7px 10px; border-radius: 9px; background: #edf5f3; color: #315f58; font-size: 13px; font-weight: 700; }
