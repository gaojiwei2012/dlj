// Edit an existing year without switching which year is active. Stay records and
// travel plans are date-based, so their statistics are recalculated on next read.
function updateYear(res,actor,old,x){
  const name=typeof x.name==='string'?x.name.trim():''
  const target=Number(x.targetDays)
  if(!name||name.length>60||!validDate(x.startDate)||!validDate(x.endDate)||x.endDate<x.startDate||!Number.isInteger(target)||target<1)
    return json(res,400,{error:'请填写有效的学年名称、开始和结束日期以及正整数目标天数'})
  const overlap=db.prepare('SELECT name,start_date,end_date FROM academic_years WHERE id!=? AND start_date<=? AND end_date>=?').get(old.id,x.endDate,x.startDate)
  if(overlap)return json(res,409,{error:`学年日期与“${overlap.name}”（${overlap.start_date} 至 ${overlap.end_date}）重叠`})
  const invalid=db.prepare("SELECT start_date,end_date FROM invalid_date_ranges WHERE academic_year_id=? AND status='ACTIVE' AND (start_date<? OR end_date>?) LIMIT 1").get(old.id,x.startDate,x.endDate)
  if(invalid)return json(res,409,{error:`已有无效逗留日期（${invalid.start_date} 至 ${invalid.end_date}）超出修改后的学年范围，请先调整该日期`})
  const manual=db.prepare("SELECT rule_date FROM date_rules WHERE type='MANUAL_INVALID' AND source='MANUAL' AND status='ACTIVE' AND rule_date BETWEEN ? AND ? AND (rule_date<? OR rule_date>?) LIMIT 1").get(old.start_date,old.end_date,x.startDate,x.endDate)
  if(manual)return json(res,409,{error:`已有无效逗留日期（${manual.rule_date}）超出修改后的学年范围，请先调整该日期`})
  const course=db.prepare("SELECT title,start_at,end_at FROM course_sessions WHERE academic_year_id=? AND status='ACTIVE' AND (substr(start_at,1,10)<? OR substr(end_at,1,10)>?) LIMIT 1").get(old.id,x.startDate,x.endDate)
  if(course)return json(res,409,{error:`集中课程“${course.title}”（${course.start_at.slice(0,10)} 至 ${course.end_at.slice(0,10)}）超出修改后的学年范围，请先调整课程日期`})
  const courseDate=db.prepare("SELECT cd.course_date FROM course_dates cd JOIN course_sessions cs ON cs.id=cd.course_session_id WHERE cs.academic_year_id=? AND cs.status='ACTIVE' AND cd.status='ACTIVE' AND (cd.course_date<? OR cd.course_date>?) LIMIT 1").get(old.id,x.startDate,x.endDate)
  if(courseDate)return json(res,409,{error:`集中课程日期 ${courseDate.course_date} 超出修改后的学年范围，请先调整课程`})
  db.prepare('UPDATE academic_years SET name=?,start_date=?,end_date=?,target_days=? WHERE id=?').run(name,x.startDate,x.endDate,target,old.id)
  const updated=db.prepare('SELECT * FROM academic_years WHERE id=?').get(old.id)
  audit(actor.id,'UPDATE','academic_year',old.id,old,updated)
  return json(res,200,{ok:true,academicYear:updated})
}
